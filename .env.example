# Required for Docker Compose / production. Use a long random string (16+ chars).
# Never use placeholders like change-me-in-production or dev-only-change-me.
SESSION_SECRET=generate-a-long-random-string

# Cookie Secure flag. false = plain HTTP (internal deploys / default Compose).
# Set true when the app is served over HTTPS so session cookies are not sent on HTTP.
COOKIE_SECURE=false

# Set true only when a trusted reverse proxy removes client-supplied forwarding
# headers and sets X-Forwarded-For / X-Real-IP itself.
TRUST_PROXY=false

# Required on the first start only. Use a unique password of 12+ characters.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Host port published by Compose (container listens on 3232)
PORT=3232

# Optional: pin image version for production pulls
# FACILITY_MAPS_IMAGE=ghcr.io/ajthom90/facility-maps:0.3.1
# APP_VERSION=0.3.1

# --- Local (non-Docker) development ---
# SQLITE_PATH=./data/facility-maps.sqlite
# UPLOAD_DIR=./data/uploads
